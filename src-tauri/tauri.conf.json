{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Carelo",
  "version": "0.6.2",
  "identifier": "dev.carelo.filemanager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1422",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Carelo",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "decorations": false,
        "transparent": true,
        "backgroundColor": "#00000000",
        "visible": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "appimage"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "Agentejo - Artur Heinze",
    "copyright": "Copyright © 2026 Agentejo - Artur Heinze",
    "license": "Proprietary",
    "category": "Utility",
    "shortDescription": "Fast, local-first file management.",
    "longDescription": "Fast, local-first file management with dual panes, previews, remotes, and custom tools.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "files": {
          "/usr/share/metainfo/dev.carelo.filemanager.metainfo.xml": "linux/dev.carelo.filemanager.metainfo.xml"
        },
        "section": "utils",
        "priority": "optional"
      },
      "rpm": {
        "files": {
          "/usr/share/metainfo/dev.carelo.filemanager.metainfo.xml": "linux/dev.carelo.filemanager.metainfo.xml"
        },
        "release": "1"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg2QTQ5NzlENEU2Qzg1QUYKUldTdmhXeE9uWmVraGp0dW8vZFRaU0Z2aVZ1OWlEc2s3dUJudkJ3elJXMmRmQkV0WDZCek5HU0MK",
      "endpoints": [
        "https://github.com/aheinze/Carelo/releases/latest/download/latest.json"
      ]
    }
  }
}
